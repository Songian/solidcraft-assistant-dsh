{
  "name": "@local/solidcraft-assistant",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "SolidCraft parametric modelling assistant for DSH: MCP connection, modelling skill and bug-report protocol.",
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./tools/brief": "./plugin/tools/brief.js",
    "./tools/calc": "./plugin/tools/calc.js",
    "./tools/verifier": "./plugin/tools/verifier.js",
    "./tools/preview": "./plugin/tools/preview.js",
    "./mcp/bridge": "./plugin/solidcraft_bridge.js"
  },
  "files": [
    "plugin/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "skills/**",
    "knowledge/**",
    "knowledge.lock"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "build": {
    "builtAt": "2026-11-04"
  }
}
